{
  "name": "browser-control-mcp",
  "version": "0.3.1",
  "description": "MCP server for browser automation with visible virtual cursor and click animations",
  "type": "module",
  "bin": {
    "browser-control-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "prepare": "npm run build",
    "install:browsers": "playwright install chromium firefox"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright": "^1.52.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0"
  }
}
